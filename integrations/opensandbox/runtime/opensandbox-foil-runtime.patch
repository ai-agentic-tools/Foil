+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""
+Foil runtime: sandboxes as copy-on-write branches of a host folder.
+
+`foil serve` (https://github.com/umbarsariya/foil) implements the lifecycle
+API itself and runs an execd-compatible daemon in every sandbox. This service
+forwards the lifecycle calls to it, so OpenSandbox's server, auth, tenancy
+and tooling front sandboxes that start in milliseconds without Docker, work
+on Linux and macOS laptops, and whose changes can be reviewed and applied to
+the real folder (`foil.diff` / `foil.commit` below).
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+from typing import Any, Optional
+
+import httpx
+from fastapi import HTTPException
+
+from opensandbox_server.api.schema import (
+    CreateSandboxRequest,
+    CreateSandboxResponse,
+    Endpoint,
+    ListSandboxesRequest,
+    ListSandboxesResponse,
+    PatchSandboxMetadataRequest,
+    RenewSandboxExpirationRequest,
+    RenewSandboxExpirationResponse,
+    Sandbox,
+)
+from opensandbox_server.config import AppConfig, FoilConfig, get_config
+from opensandbox_server.services.diagnostics import (
+    DiagnosticContext,
+    DiagnosticResult,
+    limit_diagnostic_lines,
+    unsupported_scope_error,
+)
+from opensandbox_server.services.extension_service import ExtensionService
+from opensandbox_server.services.sandbox_service import SandboxService
+
+logger = logging.getLogger(__name__)
+
+_SUPPORTED_LOG_SCOPES = ("run", "all")
+_SUPPORTED_EVENT_SCOPES = ("runtime", "all")
+_LOG_LINE_LIMIT = 100
+
+
+class FoilSandboxService(SandboxService, ExtensionService):
+    """Sandbox lifecycle on a `foil serve` instance."""
+
+    def __init__(self, config: Optional[AppConfig] = None, client: Optional[httpx.Client] = None):
+        self.app_config = config or get_config()
+        self.foil: FoilConfig = self.app_config.foil or FoilConfig()
+        key = self.foil.api_key or os.environ.get(self.foil.api_key_env, "")
+        if not key:
+            raise ValueError(f"[foil] needs api_key, or the key of `foil serve` in ${self.foil.api_key_env}")
+        self._client = client or httpx.Client(
+            base_url=self.foil.url.rstrip("/") + "/v1",
+            headers={"OPEN-SANDBOX-API-KEY": key},
+            timeout=self.foil.timeout_seconds,
+        )
+
+    def close(self) -> None:
+        self._client.close()
+
+    # ---- plumbing ----
+
+    def _call(self, method: str, path: str, **kwargs: Any) -> httpx.Response:
+        try:
+            response = self._client.request(method, path, **kwargs)
+        except httpx.HTTPError as exc:
+            raise HTTPException(
+                status_code=503,
+                detail={"code": "FOIL::UNREACHABLE", "message": f"foil serve at {self.foil.url}: {exc}"},
+            ) from exc
+        if response.status_code >= 400:
+            try:
+                body = response.json()
+                detail = {"code": f"FOIL::{body.get('code', 'ERROR')}", "message": body.get("message", response.text)}
+            except ValueError:
+                detail = {"code": "FOIL::ERROR", "message": response.text}
+            raise HTTPException(status_code=response.status_code, detail=detail)
+        return response
+
+    # ---- lifecycle ----
+
+    async def create_sandbox(self, request: CreateSandboxRequest) -> CreateSandboxResponse:
+        body = request.model_dump(by_alias=True, exclude_none=True, mode="json")
+        if self.foil.workspace and "foil.workspace" not in (body.get("extensions") or {}):
+            body.setdefault("extensions", {})["foil.workspace"] = self.foil.workspace
+        response = self._call("POST", "/sandboxes", json=body)
+        return CreateSandboxResponse.model_validate(response.json())
+
+    def list_sandboxes(self, request: ListSandboxesRequest) -> ListSandboxesResponse:
+        params: list[tuple[str, str]] = [("state", s) for s in (request.filter.state or [])]
+        if request.filter.metadata:
+            params.append(("metadata", str(httpx.QueryParams(request.filter.metadata))))
+        if request.pagination:
+            params += [("page", str(request.pagination.page)), ("pageSize", str(request.pagination.page_size))]
+        response = self._call("GET", "/sandboxes", params=params)
+        return ListSandboxesResponse.model_validate(response.json())
+
+    def get_sandbox(self, sandbox_id: str) -> Sandbox:
+        return Sandbox.model_validate(self._call("GET", f"/sandboxes/{sandbox_id}").json())
+
+    def delete_sandbox(self, sandbox_id: str) -> None:
+        self._call("DELETE", f"/sandboxes/{sandbox_id}")
+
+    def pause_sandbox(self, sandbox_id: str) -> None:
+        self._call("POST", f"/sandboxes/{sandbox_id}/pause")
+
+    def resume_sandbox(self, sandbox_id: str) -> None:
+        self._call("POST", f"/sandboxes/{sandbox_id}/resume")
+
+    def renew_expiration(
+        self, sandbox_id: str, request: RenewSandboxExpirationRequest
+    ) -> RenewSandboxExpirationResponse:
+        body = request.model_dump(by_alias=True, mode="json")
+        response = self._call("POST", f"/sandboxes/{sandbox_id}/renew-expiration", json=body)
+        return RenewSandboxExpirationResponse.model_validate(response.json())
+
+    def patch_sandbox_metadata(self, sandbox_id: str, patch: PatchSandboxMetadataRequest) -> Sandbox:
+        response = self._call("PATCH", f"/sandboxes/{sandbox_id}/metadata", json=dict(patch))
+        return Sandbox.model_validate(response.json())
+
+    def get_endpoint(
+        self,
+        sandbox_id: str,
+        port: int,
+        resolve_internal: bool = False,
+        expires: Optional[int] = None,
+        use_proxy_host: bool = False,
+    ) -> Endpoint:
+        self.validate_port(port)
+        if expires is not None:
+            raise HTTPException(
+                status_code=400,
+                detail={"code": "FOIL::SIGNED_ROUTES_UNSUPPORTED", "message": "the foil runtime has no signed routes"},
+            )
+        endpoint = Endpoint.model_validate(self._call("GET", f"/sandboxes/{sandbox_id}/endpoints/{port}").json())
+        if self.foil.endpoint_host and not resolve_internal:
+            # foil serve names itself by the address this server used; clients may need another.
+            _, _, rest = endpoint.endpoint.partition("/")
+            endpoint.endpoint = f"{self.foil.endpoint_host}/{rest}" if rest else self.foil.endpoint_host
+        return endpoint
+
+    def get_access_renew_extend_seconds(self, sandbox_id: str) -> Optional[int]:
+        return None
+
+    # ---- foil's own: review and apply ----
+
+    def get_diff(self, sandbox_id: str, patch: bool = False) -> Any:
+        response = self._call("GET", f"/sandboxes/{sandbox_id}/diff", params={"patch": str(patch).lower()})
+        return response.text if patch else response.json()
+
+    def commit(self, sandbox_id: str, force: bool = False) -> dict:
+        return self._call("POST", f"/sandboxes/{sandbox_id}/commit", json={"force": force}).json()
+
+    # ---- diagnostics ----
+
+    def get_sandbox_diagnostic_context(self, sandbox_id: str) -> DiagnosticContext:
+        sandbox = self.get_sandbox(sandbox_id)
+        ext = sandbox.extensions or {}
+        return DiagnosticContext(
+            sandboxId=sandbox_id,
+            state=sandbox.status.state,
+            backendType="foil",
+            backendIdentifiers={k: v for k, v in ext.items() if k.startswith("foil.")},
+        )
+
+    def get_sandbox_logs(
+        self, sandbox_id: str, tail: int = 100, since: str | None = None, container: str | None = None
+    ) -> str:
+        return self._call("GET", f"/sandboxes/{sandbox_id}/logs", params={"tail": tail}).text
+
+    def get_sandbox_inspect(self, sandbox_id: str) -> str:
+        return self.get_sandbox(sandbox_id).model_dump_json(by_alias=True, indent=2)
+
+    def get_sandbox_events(self, sandbox_id: str, limit: int = 50) -> str:
+        sandbox = self.get_sandbox(sandbox_id)
+        status = sandbox.status
+        return f"{status.last_transition_at or ''} {status.state} {status.reason or ''} {status.message or ''}".strip()
+
+    def get_sandbox_log_diagnostics(self, sandbox_id: str, scope: str) -> DiagnosticResult:
+        if scope.strip().lower() not in _SUPPORTED_LOG_SCOPES:
+            raise unsupported_scope_error("logs", scope, _SUPPORTED_LOG_SCOPES)
+        content = self.get_sandbox_logs(sandbox_id, tail=_LOG_LINE_LIMIT + 1)
+        content, truncated = limit_diagnostic_lines(content, _LOG_LINE_LIMIT, keep_tail=True)
+        return DiagnosticResult(sandbox_id=sandbox_id, kind="logs", scope=scope, content=content, truncated=truncated)
+
+    def get_sandbox_event_diagnostics(self, sandbox_id: str, scope: str) -> DiagnosticResult:
+        if scope.strip().lower() not in _SUPPORTED_EVENT_SCOPES:
+            raise unsupported_scope_error("events", scope, _SUPPORTED_EVENT_SCOPES)
+        return DiagnosticResult(sandbox_id=sandbox_id, kind="events", scope=scope, content=self.get_sandbox_events(sandbox_id))
