+"""Foil runtime: the service against a fake `foil serve`, and (when FOIL_BIN
+names a foil binary) against a real one."""
+
+import asyncio
+import json
+import os
+import shutil
+import socket
+import subprocess
+import time
+from datetime import datetime, timedelta, timezone
+
+import httpx
+import pytest
+from fastapi import HTTPException
+
+from opensandbox_server.api.schema import (
+    CreateSandboxRequest,
+    ListSandboxesRequest,
+    RenewSandboxExpirationRequest,
+)
+from opensandbox_server.config import AppConfig, FoilConfig, RuntimeConfig
+from opensandbox_server.services.factory import create_sandbox_service
+from opensandbox_server.services.foil import FoilSandboxService
+
+SANDBOX = {
+    "id": "0b6c1d2e-1111-4222-8333-444455556666",
+    "status": {"state": "Running", "lastTransitionAt": "2026-10-27T10:00:00Z"},
+    "entrypoint": ["tail", "-f", "/dev/null"],
+    "createdAt": "2026-10-27T10:00:00Z",
+    "metadata": {"team": "a"},
+    "extensions": {"foil.branch": "osb-0b6c1d2e", "foil.workspace": "/w", "foil.strict": "true"},
+}
+
+
+def config(**foil) -> AppConfig:
+    return AppConfig(
+        runtime=RuntimeConfig(type="foil", execd_image="unused-by-foil"),
+        foil=FoilConfig(api_key="k", **foil),
+    )
+
+
+def service_with(handler, **foil) -> FoilSandboxService:
+    cfg = config(**foil)
+    client = httpx.Client(
+        base_url="http://foil/v1",
+        headers={"OPEN-SANDBOX-API-KEY": "k"},
+        transport=httpx.MockTransport(handler),
+    )
+    return FoilSandboxService(cfg, client=client)
+
+
+def create_request(**extra) -> CreateSandboxRequest:
+    return CreateSandboxRequest.model_validate(
+        {"image": {"uri": "foil"}, "entrypoint": ["tail", "-f", "/dev/null"], "resourceLimits": {"cpu": "1"}, "timeout": 600, **extra}
+    )
+
+
+def test_the_factory_builds_the_foil_runtime():
+    assert isinstance(create_sandbox_service(config=config()), FoilSandboxService)
+
+
+def test_a_key_is_required(monkeypatch):
+    monkeypatch.delenv("FOIL_SERVE_API_KEY", raising=False)
+    cfg = AppConfig(runtime=RuntimeConfig(type="foil", execd_image="x"), foil=FoilConfig())
+    with pytest.raises(ValueError):
+        FoilSandboxService(cfg)
+
+
+def test_create_forwards_the_request_and_the_default_workspace():
+    seen = {}
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        seen["path"] = request.url.path
+        seen["key"] = request.headers["OPEN-SANDBOX-API-KEY"]
+        seen["body"] = json.loads(request.content)
+        return httpx.Response(202, json=SANDBOX)
+
+    service = service_with(handler, workspace="/w")
+    created = asyncio.run(service.create_sandbox(create_request(metadata={"team": "a"})))
+    assert created.id == SANDBOX["id"]
+    assert created.status.state == "Running"
+    assert seen["path"] == "/v1/sandboxes"
+    assert seen["key"] == "k"
+    assert seen["body"]["image"] == {"uri": "foil"}
+    assert seen["body"]["metadata"] == {"team": "a"}
+    assert seen["body"]["extensions"]["foil.workspace"] == "/w"
+
+
+def test_lifecycle_calls_map_one_to_one():
+    calls = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        calls.append((request.method, request.url.path, str(request.url.query, "ascii")))
+        path = request.url.path
+        if path.endswith("/renew-expiration"):
+            return httpx.Response(200, json={"expiresAt": "2026-10-28T10:00:00Z"})
+        if path.endswith("/endpoints/44772"):
+            return httpx.Response(200, json={"endpoint": "127.0.0.1:8090/v1/sandboxes/x/proxy/44772", "headers": {"X-EXECD-ACCESS-TOKEN": "t"}})
+        if path == "/v1/sandboxes" and request.method == "GET":
+            pagination = {"page": 1, "pageSize": 20, "totalItems": 1, "totalPages": 1, "hasNextPage": False}
+            return httpx.Response(200, json={"items": [SANDBOX], "pagination": pagination})
+        if request.method in ("DELETE",):
+            return httpx.Response(204)
+        if path.endswith(("/pause", "/resume")):
+            return httpx.Response(202)
+        return httpx.Response(200, json=SANDBOX)
+
+    service = service_with(handler, endpoint_host="foil.example:9000")
+    sid = SANDBOX["id"]
+    assert service.get_sandbox(sid).id == sid
+    listed = service.list_sandboxes(ListSandboxesRequest.model_validate({"filter": {"state": ["Running"], "metadata": {"team": "a"}}}))
+    assert [s.id for s in listed.items] == [sid]
+    service.pause_sandbox(sid)
+    service.resume_sandbox(sid)
+    renewed = service.renew_expiration(sid, RenewSandboxExpirationRequest(expiresAt=datetime.now(timezone.utc) + timedelta(hours=1)))
+    assert renewed.expires_at.year == 2026
+    assert service.patch_sandbox_metadata(sid, {"team": None}).id == sid
+    endpoint = service.get_endpoint(sid, 44772)
+    assert endpoint.endpoint == "foil.example:9000/v1/sandboxes/x/proxy/44772"
+    assert endpoint.headers == {"X-EXECD-ACCESS-TOKEN": "t"}
+    assert service.get_endpoint(sid, 44772, resolve_internal=True).endpoint.startswith("127.0.0.1:8090/")
+    service.delete_sandbox(sid)
+    methods = [(m, p.rsplit("/", 1)[-1]) for m, p, _ in calls]
+    assert ("POST", "pause") in methods and ("POST", "resume") in methods and ("DELETE", sid) in methods
+    list_query = next(q for m, p, q in calls if m == "GET" and p == "/v1/sandboxes")
+    assert "state=Running" in list_query and "metadata=team%3Da" in list_query
+
+
+def test_errors_keep_their_status_and_say_foil():
+    def handler(request: httpx.Request) -> httpx.Response:
+        return httpx.Response(409, json={"code": "CONFLICT", "message": "changed in /w since the sandbox started: a.txt"})
+
+    service = service_with(handler)
+    with pytest.raises(HTTPException) as err:
+        service.commit(SANDBOX["id"])
+    assert err.value.status_code == 409
+    assert err.value.detail["code"] == "FOIL::CONFLICT"
+
+
+def test_an_unreachable_foil_serve_is_a_503():
+    def handler(request: httpx.Request) -> httpx.Response:
+        raise httpx.ConnectError("refused")
+
+    with pytest.raises(HTTPException) as err:
+        service_with(handler).get_sandbox("x")
+    assert err.value.status_code == 503
+
+
+def test_signed_endpoints_are_refused():
+    service = service_with(lambda r: httpx.Response(200, json={"endpoint": "h/p"}))
+    with pytest.raises(HTTPException) as err:
+        service.get_endpoint("x", 44772, expires=int(time.time()) + 60)
+    assert err.value.status_code == 400
+
+
+def free_port() -> int:
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+@pytest.mark.skipif(not os.environ.get("FOIL_BIN") or not shutil.which(os.environ.get("FOIL_BIN", "")), reason="FOIL_BIN names no foil binary")
+def test_against_a_real_foil_serve(tmp_path):
+    workspace = tmp_path / "ws"
+    workspace.mkdir()
+    (workspace / "a.txt").write_text("old\n")
+    port = free_port()
+    env = dict(os.environ, OPEN_SANDBOX_API_KEY="k", FOIL_HOME=str(tmp_path / "foil-home"))
+    proc = subprocess.Popen(
+        [os.environ["FOIL_BIN"], "serve", "--listen", f"127.0.0.1:{port}", "-w", str(workspace)],
+        env=env,
+        stderr=subprocess.DEVNULL,
+    )
+    try:
+        for _ in range(100):
+            try:
+                httpx.get(f"http://127.0.0.1:{port}/health")
+                break
+            except httpx.HTTPError:
+                time.sleep(0.05)
+        service = FoilSandboxService(config(url=f"http://127.0.0.1:{port}"))
+        created = asyncio.run(service.create_sandbox(create_request()))
+        endpoint = service.get_endpoint(created.id, 44772)
+        events = httpx.post(f"http://{endpoint.endpoint}/command", headers=endpoint.headers, json={"command": "echo new > a.txt"})
+        assert events.status_code == 200
+        assert (workspace / "a.txt").read_text() == "old\n"
+        assert service.get_diff(created.id)["changes"] == [{"kind": "M", "path": "a.txt"}]
+        assert service.commit(created.id)["applied"] == 1
+        assert (workspace / "a.txt").read_text() == "new\n"
+        with pytest.raises(HTTPException) as err:
+            service.get_sandbox(created.id)
+        assert err.value.status_code == 404
+    finally:
+        proc.terminate()
+        proc.wait()
